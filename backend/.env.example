# ============================================
# PFM AI App - Backend Environment Variables
# Copy this file to .env and fill in values
# ============================================

# Database (PostgreSQL)
DATABASE_URL=postgresql://pfm_user:pfm_password@localhost:5432/pfm_db

# Redis
REDIS_URL=redis://localhost:6379

# JWT Auth
SECRET_KEY=your-super-secret-key-min-32-chars-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI APIs (Optional - for chatbot)
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key

# Bank API (Setu - India)
SETU_CLIENT_ID=your-setu-client-id
SETU_CLIENT_SECRET=your-setu-client-secret
SETU_BASE_URL=https://prod.setu.co/api

# Webhook Secret
WEBHOOK_SECRET=your-webhook-secret-for-hmac

# Environment
ENVIRONMENT=development
DEBUG=true

